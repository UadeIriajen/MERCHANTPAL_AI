# Point this at the same Postgres instance lib/db (Drizzle) uses if you want
# both stacks to share one database.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/merchantpal

# Comma-separated list of origins allowed to call this API (the Vite dev
# server runs on 5173 by default).
CORS_ORIGINS=http://localhost:5173

# Supabase project URL and public anon key. Used by the backend to verify
# bearer tokens through Supabase Auth.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional. Powers real LLM understanding of voice transcripts in
# POST /assistant/interpret (src/services/llm_transcript_parser.py). Without
# it, that endpoint automatically falls back to the free rule-based parser
# in src/services/transcript_parser.py — leave unset until you're ready.
ANTHROPIC_API_KEY=

# Supabase Auth JWT secret. When set, business APIs require a valid Supabase
# access token. Leave unset only for local anonymous development.
SUPABASE_JWT_SECRET=
